<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Photos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>My Photography</h1>
        <p>A collection of images.</p>
    </header>

    <main>
        <h2>Galleries</h2>
        <ul>
            {% for gallery in galleries %}
            <li>
                <a href="/gallery/{{ gallery.slug }}/">{{ gallery.title }}</a> 
                <span class="meta">({{ gallery.images | length }} images)</span>
            </li>
            {% endfor %}
        </ul>
        
        {% if galleries.length == 0 %}
        <p><em>No galleries found. Create a folder in <code>src/photos/</code> to begin.</em></p>
        {% endif %}
    </main>

    <footer>
        <hr>
        <p><small>&copy; Your Name</small></p>
    </footer>
</body>
</html>
